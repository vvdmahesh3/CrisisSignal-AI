# ── CrisisSignal AI — Environment Configuration ──────────────
# Copy this file to .env and fill in the values.
# NEVER commit your real .env file to git.

# ── Flask ────────────────────────────────────────────────────
FLASK_ENV=development
# Production: generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production

# ── Database ─────────────────────────────────────────────────
# Development: SQLite (auto-created)
DATABASE_URL=sqlite:///instance/crisissignal_dev.db
# Production (PostgreSQL — Phase 4):
# DATABASE_URL=postgresql://crisissignal:STRONG_PASSWORD@localhost:5432/crisissignal

# ── PostgreSQL (docker-compose — Phase 4) ────────────────────
POSTGRES_DB=crisissignal
POSTGRES_USER=crisissignal
POSTGRES_PASSWORD=replace-with-strong-db-password

# ── Error Tracking (Phase 4 — Sentry) ────────────────────────
# Leave blank to disable. Get DSN from https://sentry.io
SENTRY_DSN=

# ── Logging (Phase 4) ─────────────────────────────────────────
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# JSON_LOGS=true  →  structured JSON output for log aggregators (Datadog/GCP/AWS)
JSON_LOGS=false

# ── Features ─────────────────────────────────────────────────
DEMO_MODE_ENABLED=true

# ── Seed Passwords (Phase 0 — no plain text in source code) ──
# Set these before running `flask seed` or `flask reset-db`.
SEED_ADMIN_PASSWORD=replace-with-strong-admin-password
SEED_SECURITY_PASSWORD=replace-with-strong-security-password
SEED_GUARD_PASSWORD=replace-with-strong-guard-password
SEED_WARDEN_PASSWORD=replace-with-strong-warden-password
SEED_STUDENT_PASSWORD=replace-with-strong-student-password
SEED_NURSE_PASSWORD=replace-with-strong-nurse-password
